    <!DOCTYPE html>
    <html lang="ar" dir="rtl">
    <head>
        <meta charset="UTF-8">
        <title>متجر التطبيقات</title>
        <style>
            body {font-family: sans-serif; margin: 20px;}
            .app {border: 1px solid #ddd; padding: 10px; margin: 10px 0;}
        </style>
    </head>
    <body>
        <h1>متجر التطبيقات</h1>
        {% for app in apps %}
        <div class="app">
            <h2>{{ app.name }}</h2>
            <p>{{ app.desc }}</p>
            <p><b>السعر: {{ app.price }}</b></p>
        </div>
        {% endfor %}
    </body>
    </html>
    ''', apps=apps)

if __name__ == '__main__':
    app.run(debug=True)
